{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lokyy://frontmatter/base",
  "type": "object",
  "required": ["id", "type", "title", "created", "updated"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID — 26 chars, Crockford base32, no I/L/O/U."
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "capture",
        "project",
        "task",
        "decision",
        "meeting",
        "customer",
        "workflow",
        "intervention",
        "content"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "privacy": {
      "type": "string",
      "enum": ["default", "local-only"],
      "default": "default",
      "description": "Privacy tier for AI operations. 'local-only' forces local LLM provider regardless of user settings; 'default' follows global privacyTier setting."
    }
  },
  "additionalProperties": true
}
