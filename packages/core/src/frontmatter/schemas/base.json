{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lokyy://frontmatter/base",
  "type": "object",
  "required": ["id", "type", "title", "created", "updated"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID — 26 chars, Crockford base32, no I/L/O/U."
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "capture",
        "project",
        "task",
        "decision",
        "meeting",
        "customer",
        "workflow",
        "intervention",
        "content",
        "peer"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "privacy": {
      "type": "string",
      "enum": ["default", "local-only"],
      "default": "default",
      "description": "Privacy tier for AI operations. 'local-only' forces local LLM provider regardless of user settings; 'default' follows global privacyTier setting."
    },
    "encoded": {
      "type": "object",
      "additionalProperties": true,
      "description": "Encoding-context captured at note creation time. Used by the Encoding-Context-Match-Boost (Tulving 1973) to boost retrieval when the query-time context matches the encoding-time context. All fields optional; absent block is the default for legacy notes.",
      "properties": {
        "device": {
          "type": "string",
          "enum": ["laptop", "desktop", "mobile", "tablet", "api", "mcp"]
        },
        "app_state": { "type": "string" },
        "time_of_day": {
          "type": "string",
          "enum": ["morning", "midday", "evening", "night"]
        },
        "weekday": {
          "type": "string",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "preceding_notes": { "type": "array", "items": { "type": "string" } },
        "session_duration_min": { "type": "integer", "minimum": 0 },
        "word_count_session": { "type": "integer", "minimum": 0 },
        "source": { "type": "object", "additionalProperties": true }
      }
    }
  },
  "additionalProperties": true
}
