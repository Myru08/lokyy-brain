# lokyy-brain — Coolify environment variables.
# Paste each row into Coolify UI → "Environment Variables".
#
# EMPFOHLENER WEG: docker-compose.coolify.yml (ALLES in EINER Resource).
# Damit fällt manueller Env-Aufwand auf ein Minimum:
#   • DB-Passwort wird von Coolify als Auto-Secret erzeugt
#     (SERVICE_PASSWORD_POSTGRES — NICHT manuell setzen, Coolify füllt es).
#   • Servicenamen (postgres, ollama, forgejo) lösen nativ auf — keine UUIDs.
# Manuell nötig sind dann nur: die Domains (Add Domain) + LOKYY_MCP_TOKEN
# + (optional) Forgejo-OAuth + Vault-ID nach dem Wizard.
#
# Values prefixed SERVICE_FQDN_* are rewritten by Coolify automatically once
# you attach a domain to the matching service in the UI ("Add Domain").
# SERVICE_PASSWORD_* / SERVICE_*  = Auto-Secrets, von Coolify generiert.
#
# DNS prerequisite: A-records for each subdomain must point at the VPS IP
# BEFORE the first deploy, otherwise Let's-Encrypt certificate issuance fails.

# ── Coolify magic-vars (set indirectly via "Add Domain" in UI) ───────────
# lokyy-brain (server / REST API):    https://lokyy.example.tld
# lokyy-pwa   (browser UI):           https://lokyy.example.tld  (same FQDN OK if you split paths in Coolify; else use ui.lokyy.example.tld)
# lokyy-mcp   (claude.ai endpoint):   https://mcp.lokyy.example.tld
# forgejo     (vault git UI):         https://forgejo.lokyy.example.tld

# ── Secrets (generate with: openssl rand -hex 32) ───────────────────────
# DB-Passwort:
#   • All-in-One (empfohlen): NICHTS eintragen — Coolify erzeugt
#     SERVICE_PASSWORD_POSTGRES automatisch und setzt es in DB + DATABASE_URL.
#   • Split-Variante (coolify-postgres.yml + coolify-app.yml): hier
#     POSTGRES_PASSWORD setzen und auf BEIDEN Resources identisch (Shared Var).
POSTGRES_PASSWORD=CHANGE_ME_only_for_split_variant_min_24_chars
# Bearer-Token, das du in claude.ai (Custom Connector) einträgst — selbst wählen.
LOKYY_MCP_TOKEN=CHANGE_ME_long_random_token_min_32_chars
# OAuth 2.1 consent-page password claude.ai users must enter to authorize.
# Defaults to LOKYY_MCP_TOKEN if unset.
LOKYY_OAUTH_PASSWORD=
# HS256 secret for signing OAuth access/refresh tokens.
# Defaults to a value derived from LOKYY_MCP_TOKEN if unset —
# set a strong random value in production (openssl rand -hex 32).
LOKYY_OAUTH_SIGNING_SECRET=

# ── Forgejo OAuth-App (Vault-Anbindung läuft jetzt über OAuth, nicht Token-URL) ──
# Setup-Wizard Step 1 ruft den OAuth-Flow gegen Forgejo. Lege dafür einmalig
# in Forgejo unter User Settings → Applications → OAuth2 Applications eine
# App an mit Redirect URI:
#   https://<deine-pwa-domain>/api/auth/forgejo/callback
# Forgejo gibt dir Client-ID + Secret zurück — die kommen hier rein.
FORGEJO_BASE_URL=https://forgejo.example.tld
FORGEJO_OAUTH_CLIENT_ID=CHANGE_ME_forgejo_client_id
FORGEJO_OAUTH_CLIENT_SECRET=CHANGE_ME_forgejo_client_secret

# Legacy: nur noch nötig, wenn du den Wizard NICHT benutzt und stattdessen die
# Vault-Anbindung per .env hart konfigurieren willst (z. B. headless deploys).
# Im Normalfall leer lassen — der Wizard schreibt OAuth-Token + Repo direkt in
# die DB und gitService injectet den Token zur Laufzeit.
# GIT_REMOTE=
# GIT_BRANCH=main
# GIT_AUTHOR_NAME=lokyy-brain
# GIT_AUTHOR_EMAIL=lokyy-brain@example.tld

# ── Vault ULID (filled in AFTER first run of Setup Wizard) ──────────────
# Two-step bootstrap:
#   1. Deploy with LOKYY_VAULT_ID empty (the lokyy-mcp container will crash-loop;
#      that's expected — server + Setup Wizard still work).
#   2. Open https://lokyy.example.tld → Setup Wizard → finish.
#   3. Get the vault ID (and its slug, so you pin the RIGHT one):
#        docker exec <postgres-container> psql -U postgres -d lokyy_brain \
#          -c "SELECT id, slug FROM vaults;"
#   4. Set LOKYY_VAULT_ID in Coolify to the id whose slug is your real vault,
#      then redeploy lokyy-mcp.
#
# MULTI-VAULT HAZARD: leaving this empty with more than one vault row makes the
# MCP server fall back to "pick oldest" (oldest created_at) and silently attach
# to it — which may be the WRONG vault (data-loss hazard). It logs a loud
# warning, but ALWAYS pin LOKYY_VAULT_ID explicitly once a second vault exists.
LOKYY_VAULT_ID=

# MCP agent-identity (must match an entry in vault's 00_meta/mcp-scopes.yaml).
# Default vault ships with `claude-code` granted read:** + write:**.
LOKYY_AGENT_ID=claude-code

# ── Ollama (embeddings + optional local chat) ───────────────────────────
# nomic-embed-text (768-dim) is mandatory — Tier-2 semantic index needs it.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Set to "true" to also pull a local chat model at startup (~5GB download).
# Keep false if you'll use Anthropic/OpenAI via the Settings UI.
OLLAMA_PULL_CHAT=false
OLLAMA_CHAT_MODEL=llama3.1:8b

# ── Update-Check (Story 7.12) ───────────────────────────────────────────
# Einmal beim Start, Ergebnis 6 h im Speicher. Unauthentifizierter GET auf die
# CHANGELOG.md des oeffentlichen Repos — es werden KEINE Nutzerdaten
# uebertragen. Fehlschlag = folgenlos (kein Banner, kein error-Log).
#
# Auf Coolify aktualisiert die Deploy-Plattform, nicht die Oberflaeche: der
# Check zeigt hier nur an, dass eine neue Version existiert.
# "off" (auch: false / 0 / no) schaltet ihn komplett ab.
LOKYY_UPDATE_CHECK=
# Andere Quelle (Fork / abgeschottete Installation / QA-Testdatei).
# Default: https://raw.githubusercontent.com/oliverhees/lokyy-brain/main/CHANGELOG.md
LOKYY_UPDATE_CHECK_URL=
# Abstand zwischen zwei automatischen Pruefungen, in Stunden. Leer = 8 (3x
# taeglich), zusaetzlich zum Check beim Start. Minimum 15 min; unbrauchbare
# Werte fallen auf 8 h zurueck — abgeschaltet wird nur ueber
# LOKYY_UPDATE_CHECK=off. Der Knopf "Jetzt pruefen" (Einstellungen → System)
# prueft jederzeit sofort, max. eine echte Pruefung pro 30 s.
LOKYY_UPDATE_CHECK_INTERVAL_HOURS=

# ── Ein-Klick-Update (Story 7.12) ───────────────────────────────────────
# Hier gibt es KEINEN Updater-Sidecar: kein Host-Klon, kein Docker-Socket,
# und `docker-compose.coolify*.yml` enthaelt den Dienst bewusst nicht.
# Aktualisiert wird ueber Coolify. Der Brain erkennt das von selbst (er
# findet keinen Updater und meldet `canUpdate: false, reason: "managed"`),
# die Oberflaeche zeigt dann einen Hinweis statt eines Knopfes.
#
# Diese Zeile macht es explizit und spart den Erreichbarkeits-Test:
LOKYY_UPDATE_MODE=managed

# ── CORS ─────────────────────────────────────────────────────────────────
# Fremde Browser-Origins, die die API cross-origin aufrufen duerfen
# (Komma-Liste). Leer lassen, wenn PWA und API dieselbe Domain haben — dann ist
# alles Same-Origin und CORS greift nicht. Nur setzen, wenn du die PWA unter
# einer separaten FQDN betreibst und sie direkt auf die API-Domain zeigt.
# Ein Wildcard "*" gibt es nicht: die API authentifiziert per Session-Cookie.
LOKYY_CORS_ORIGINS=

# ── Session-Cookie ─────────────────────────────────────────────────────────
# Coolify terminiert TLS am Traefik-Proxy — die App laeuft also hinter HTTPS.
# `true` setzen, damit das Session-Cookie das `secure`-Flag traegt und nie
# ueber unverschluesseltes HTTP uebertragen wird. Leer lassen leitet nur ueber
# NODE_ENV ab, das im Container nicht zwingend `production` ist — darum explizit.
LOKYY_COOKIE_SECURE=true

# Hinweis: LOKYY_BIND_ADDR (Host-Port-Binding) gilt NUR fuer die generische
# docker-compose.yml. Im Coolify-Deploy uebernimmt Traefik die Erreichbarkeit
# ueber die attachten Domains (siehe DEPLOY.md), die Services publishen keine
# Host-Ports — die Variable hat hier also keine Wirkung und bleibt ungesetzt.

# ── Optional integrations (also configurable per-vault in Settings UI) ──
SUPADATA_API_KEY=
# Leave empty if you'll add LLM provider keys later via the Settings UI.
# These are picked up at startup; UI overrides persist in DB regardless.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
