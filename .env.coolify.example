# lokyy-brain — Coolify environment variables.
# Paste each row into Coolify UI → "Environment Variables".
# Values prefixed SERVICE_FQDN_* are rewritten by Coolify automatically once
# you attach a domain to the matching service in the UI ("Add Domain").
#
# DNS prerequisite: A-records for each subdomain must point at the VPS IP
# BEFORE the first deploy, otherwise Let's-Encrypt certificate issuance fails.

# ── Coolify magic-vars (set indirectly via "Add Domain" in UI) ───────────
# lokyy-brain (server / REST API):    https://lokyy.example.tld
# lokyy-pwa   (browser UI):           https://lokyy.example.tld  (same FQDN OK if you split paths in Coolify; else use ui.lokyy.example.tld)
# lokyy-mcp   (claude.ai endpoint):   https://mcp.lokyy.example.tld
# forgejo     (vault git UI):         https://forgejo.lokyy.example.tld

# ── Secrets (generate with: openssl rand -hex 32) ───────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_min_24_chars
LOKYY_MCP_TOKEN=CHANGE_ME_long_random_token_min_32_chars

# ── Vault / Forgejo ──────────────────────────────────────────────────────
# Two flavours, depending on your deploy pattern:
#
# A) Forgejo läuft mit auf derselben Coolify-Box (DEPLOY.md / DEPLOY-RESOURCES.md)
#    → Container-internen Hostnamen verwenden, anonym ist okay wenn Repo public:
#      GIT_REMOTE=http://forgejo:3000/oliver/lokyy-vault
#
# B) Forgejo läuft EXTERN (Lean-Deploy, DEPLOY-LEAN.md)
#    → HTTPS + Application-Token im URL. Token in Forgejo erzeugen unter
#      User Settings → Applications → Generate New Token (Scope: repo:write).
#      Bei Sonderzeichen den Token URL-encoden.
#      GIT_REMOTE=https://oliver:<forgejo-token>@vault.example.tld/oliver/lokyy-vault
GIT_REMOTE=https://forgejo.lokyy.example.tld/oliver/lokyy-vault
GIT_BRANCH=main
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@example.tld

# ── Vault ULID (filled in AFTER first run of Setup Wizard) ──────────────
# Two-step bootstrap:
#   1. Deploy with LOKYY_VAULT_ID empty (the lokyy-mcp container will crash-loop;
#      that's expected — server + Setup Wizard still work).
#   2. Open https://lokyy.example.tld → Setup Wizard → finish.
#   3. Get the vault ID:
#        docker exec <postgres-container> psql -U postgres -d lokyy_brain \
#          -c "SELECT id FROM vaults;"
#   4. Set LOKYY_VAULT_ID in Coolify, redeploy lokyy-mcp.
LOKYY_VAULT_ID=

# MCP agent-identity (must match an entry in vault's 00_meta/mcp-scopes.yaml).
# Default vault ships with `claude-code` granted read:** + write:**.
LOKYY_AGENT_ID=claude-code

# ── Ollama (embeddings + optional local chat) ───────────────────────────
# nomic-embed-text (768-dim) is mandatory — Tier-2 semantic index needs it.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Set to "true" to also pull a local chat model at startup (~5GB download).
# Keep false if you'll use Anthropic/OpenAI via the Settings UI.
OLLAMA_PULL_CHAT=false
OLLAMA_CHAT_MODEL=llama3.1:8b

# ── Optional integrations (also configurable per-vault in Settings UI) ──
SUPADATA_API_KEY=
# Leave empty if you'll add LLM provider keys later via the Settings UI.
# These are picked up at startup; UI overrides persist in DB regardless.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
