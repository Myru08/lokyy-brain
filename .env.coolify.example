# Coolify Environment Variables für lokyy-brain
# In der Coolify UI unter "Environment Variables" einfügen.
# Coolify ersetzt SERVICE_FQDN_* automatisch durch die echten URLs deiner
# konfigurierten Domains.

# ── SERVICE_FQDN — Coolify-Magic ───────────────────────────────────────────
# In Coolify UI: "Add Domain" pro Service. SERVICE_FQDN_<NAME>_<PORT> wird
# automatisch hinzugefügt und an Traefik weitergegeben.
#
# Im UI ZUSÄTZLICH "Add Domain" anklicken und Domains zuordnen:
#   lokyy-brain   → https://lokyy.deine-domain.tld          (PWA + REST)
#   lokyy-mcp     → https://mcp.lokyy.deine-domain.tld      (MCP-Endpoint für claude.ai)
#   forgejo       → https://forgejo.lokyy.deine-domain.tld  (Git-UI)
#
# WICHTIG: Subdomain-A-Records bei deinem DNS-Provider auf VPS-IP setzen.

# ── Secrets ────────────────────────────────────────────────────────────────
# Generiere starke zufällige Werte: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
LOKYY_MCP_TOKEN=CHANGE_ME_long_random_token_min_32_chars

# ── Vault ──────────────────────────────────────────────────────────────────
GIT_REMOTE=https://forgejo.paione.de/oliver/mein-vault
GIT_BRANCH=main
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@deine-domain.tld

# Vault-Row-ULID. Erst nach dem ersten Deploy + Setup-Wizard verfügbar.
# Vorgehensweise:
#   1. Erstes Deploy ohne LOKYY_VAULT_ID (oder mit dummy "")
#   2. Setup-Wizard im Browser durchlaufen, Vault anlegen
#   3. Vault-ID aus Postgres holen: docker exec lokyy-postgres-... psql -U postgres -d lokyy_brain -c "SELECT id FROM vaults;"
#   4. LOKYY_VAULT_ID in Coolify env setzen
#   5. lokyy-mcp Service redeployen
LOKYY_VAULT_ID=

# Agent-Identity wie er in mcp-scopes.yaml steht (default-Vault hat: claude-code, brainbutler, hermes, etc.)
LOKYY_AGENT_ID=claude-code

# ── Optional ───────────────────────────────────────────────────────────────
SUPADATA_API_KEY=
