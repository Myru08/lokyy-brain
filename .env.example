# lokyy-brain — root .env.example (deploy reference).
#
# This file lists every env var the production stack reads. For Coolify
# deployments use .env.coolify.example. For local docker-compose use
# docker-compose.local.yml directly — every value below already has a
# working default baked in, so `.env` is optional; copy this file only if
# you want to override something (cp .env.example .env, then
# `docker compose -f docker-compose.local.yml up -d`).
# For local non-docker dev: see server/.env.example.

# ── Database ─────────────────────────────────────────────────────────────
# Connection string used by both server and MCP. Inside docker the host is
# `postgres`; on bare-metal it's whatever you wired up.
DATABASE_URL=postgres://postgres:CHANGEME@postgres:5432/lokyy_brain
#
# LOCAL DOCKER INSTALLS: do NOT copy this line into your .env by hand.
# install.sh/install.ps1 generate a random per-installation password and write
# it to .env for you — but only on a FRESH install (no .env, no postgres
# volume yet). Postgres bakes POSTGRES_PASSWORD into its data volume on the
# very first start and ignores it from then on, so changing this value later
# locks the application out of its own database. To change it after the fact,
# see the README section "Eigenes Datenbank-Passwort nachrüsten".
# Existing installs that predate this keep working on the compose fallback
# (`lokyylocal`) — that fallback stays in docker-compose.local.yml on purpose.
POSTGRES_PASSWORD=CHANGEME

# ── Ollama (embeddings + optional local chat) ───────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_PULL_CHAT=false
OLLAMA_CHAT_MODEL=llama3.1:8b

# ── Forgejo (vault git remote) ──────────────────────────────────────────
# Container-internal Forgejo URL during boot. Setup Wizard rewrites the
# remote to the public URL once you provide the FQDN.
GIT_REMOTE=http://forgejo:3000/oliver/lokyy-vault
GIT_BRANCH=main
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@localhost

# ── Server ───────────────────────────────────────────────────────────────
VAULT_DIR=/var/lokyy/vault
PORT=8787
NODE_ENV=production
# Browser-Origins, die die API cross-origin aufrufen duerfen (Komma-Liste,
# z. B. https://brain.example.com,https://lokyy.example.com).
#
# Fast immer LEER LASSEN: die PWA wird vom selben Server ausgeliefert wie die
# API, und im Dev laeuft sie ueber den Vite-Proxy — beides ist Same-Origin, da
# greift CORS gar nicht. Ein Eintrag ist nur noetig, wenn ein Frontend unter
# einer ANDEREN Domain direkt auf diese API zeigt.
#
# Leer = Vites Dev-Adressen (http://localhost:5173, http://127.0.0.1:5173).
# Ein Platzhalter "*" wird bewusst NICHT unterstuetzt: die API authentifiziert
# per Session-Cookie, und ein Wildcard wuerde jede fremde Seite mitlesen lassen.
LOKYY_CORS_ORIGINS=

# ── MCP HTTP transport ──────────────────────────────────────────────────
LOKYY_MCP_HTTP_PORT=8788
# OPTIONAL (legacy): static bearer token for MCP clients.
# Der empfohlene Weg ist Einstellungen → MCP → „Token erzeugen": der Token wird
# in der Datenbank verwaltet, gilt SOFORT ohne Neustart und lässt sich einzeln
# widerrufen. Diese Variable bleibt als Fallback gleichberechtigt gültig (alte
# Client-Configs laufen weiter), ändern erfordert aber einen Neustart.
# Leer lassen → /mcp akzeptiert ausschließlich die in der UI erzeugten Token.
# Wenn doch gesetzt: NIEMALS den Default aus docker-compose.local.yml benutzen —
# der steht im öffentlichen Repo. Generieren: openssl rand -hex 32
LOKYY_MCP_TOKEN=
# OAuth 2.1 consent-page password claude.ai users must enter to authorize.
# Defaults to LOKYY_MCP_TOKEN if unset.
LOKYY_OAUTH_PASSWORD=
# HS256 secret for signing OAuth access/refresh tokens.
# Defaults to a value derived from LOKYY_MCP_TOKEN if unset —
# set a strong random value in production (openssl rand -hex 32).
LOKYY_OAUTH_SIGNING_SECRET=
# Filled AFTER first Setup Wizard run — see DEPLOY.md step 5.
#
# MULTI-VAULT HAZARD — pin this explicitly. If LOKYY_VAULT_ID is empty AND the
# DB holds more than one vault row, the MCP server falls back to "pick oldest"
# (oldest created_at row) and logs a loud warning, but still attaches — which
# risks silently serving the WRONG vault (data-loss hazard). With exactly one
# vault the fallback is unambiguous; with several you MUST set this.
# Find the id (and match it to the slug you actually use):
#   docker exec <postgres-container> psql -U postgres -d lokyy_brain \
#     -c "SELECT id, slug FROM vaults;"
# then set LOKYY_VAULT_ID to the id whose slug is your real vault.
LOKYY_VAULT_ID=
# Must match an entry in <vault>/00_meta/mcp-scopes.yaml
LOKYY_AGENT_ID=claude-code

# ── Update-Check (Story 7.12) ───────────────────────────────────────────
# Beim Start prueft der Server einmal, ob eine neuere Version vorliegt, und
# haelt das Ergebnis 6 h im Speicher. Der Aufruf ist ein einfacher, nicht
# authentifizierter GET auf die CHANGELOG.md des oeffentlichen Repos und
# UEBERTRAEGT KEINE NUTZERDATEN — keine Vault-Inhalte, keine IDs, keine
# Telemetrie. Schlaegt er fehl (offline, DNS tot, 404/429), passiert nichts:
# kein Banner, keine Fehlermeldung, kein Log auf error-Level.
#
# "off" (auch: false / 0 / no) schaltet den Check komplett ab.
LOKYY_UPDATE_CHECK=
# Andere Quelle fuer den Check — fuer Forks, abgeschottete Installationen oder
# QA gegen eine Testdatei. Leer = offizielles Repo.
# Default: https://raw.githubusercontent.com/oliverhees/lokyy-brain/main/CHANGELOG.md
LOKYY_UPDATE_CHECK_URL=
# Abstand zwischen zwei automatischen Pruefungen, in Stunden. Leer = 8 (also
# 3x taeglich). Der Start-Check bleibt davon unberuehrt, der Timer setzt danach
# ein. Nachkommastellen sind erlaubt (0.5 = alle 30 min); Minimum sind 15 min,
# unbrauchbare Werte (Text, 0, negativ) fallen auf 8 h zurueck. Zum Abschalten
# gibt es genau einen Schalter, und das ist LOKYY_UPDATE_CHECK=off — nicht 0.
# Unabhaengig davon prueft der Knopf "Jetzt pruefen" unter Einstellungen →
# System sofort (serverseitig auf max. eine echte Pruefung pro 30 s begrenzt).
LOKYY_UPDATE_CHECK_INTERVAL_HOURS=

# ── Ein-Klick-Update (Story 7.12) ───────────────────────────────────────
# Der Brain aktualisiert NICHT selbst. Er reicht `Jetzt aktualisieren` an den
# Sidecar `lokyy-updater` weiter — der einzige Dienst, der den Host-Klon und
# den Docker-Socket sieht. Ist kein Updater erreichbar, zeigt die Oberflaeche
# statt des Knopfes einen Hinweis; einen toten Knopf gibt es nie.
#
# Adresse des Sidecars im Compose-Netz. Leer = Default aus der Compose-Datei
# (http://lokyy-updater:8799). Der Updater wird NIE auf den Host gemappt.
LOKYY_UPDATER_URL=
# Gemeinsames Geheimnis Brain -> Updater, mindestens 16 Zeichen. MUSS bei
# beiden Diensten identisch sein. install.sh bzw. install.ps1 erzeugen den
# Wert beim Setup automatisch und haengen ihn an die .env an — auch bei einer
# bestehenden Installation. Ein bereits gesetzter Wert bleibt unangetastet.
# Fehlt er, verweigert der Updater jedes Update und die Oberflaeche sagt,
# was zu tun ist.
LOKYY_UPDATER_TOKEN=
# Erkennung ueberschreiben. Leer = automatisch, anhand der Erreichbarkeit:
#   local   — Updater wird erwartet. Ist er weg, meldet die Oberflaeche einen
#             Fehler statt "laeuft ueber die Plattform" (ehrlicher fuer eine
#             kaputte lokale Installation).
#   managed — nie ein Knopf; aktualisiert wird ueber die Deploy-Plattform.
#   off     — Update ueber die Oberflaeche komplett abgeschaltet.
LOKYY_UPDATE_MODE=

# ── Optional integrations (also configurable in the Settings UI) ────────
SUPADATA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
# haelt das Ergebnis 6 h im Speicher. Der Aufruf ist ein einfacher, nicht
# authentifizierter GET auf die CHANGELOG.md des oeffentlichen Repos und
# UEBERTRAEGT KEINE NUTZERDATEN — keine Vault-Inhalte, keine IDs, keine
# Telemetrie. Schlaegt er fehl (offline, DNS tot, 404/429), passiert nichts:
# kein Banner, keine Fehlermeldung, kein Log auf error-Level.
#
# "off" (auch: false / 0 / no) schaltet den Check komplett ab.
LOKYY_UPDATE_CHECK=
# Andere Quelle fuer den Check — fuer Forks, abgeschottete Installationen oder
# QA gegen eine Testdatei. Leer = offizielles Repo.
# Default: https://raw.githubusercontent.com/oliverhees/lokyy-brain/main/CHANGELOG.md
LOKYY_UPDATE_CHECK_URL=

# ── Ein-Klick-Update (Story 7.12) ───────────────────────────────────────
# Der Brain aktualisiert NICHT selbst. Er reicht `Jetzt aktualisieren` an den
# Sidecar `lokyy-updater` weiter — der einzige Dienst, der den Host-Klon und
# den Docker-Socket sieht. Ist kein Updater erreichbar, zeigt die Oberflaeche
# statt des Knopfes einen Hinweis; einen toten Knopf gibt es nie.
#
# Adresse des Sidecars im Compose-Netz. Leer = Default aus der Compose-Datei
# (http://lokyy-updater:8799). Der Updater wird NIE auf den Host gemappt.
LOKYY_UPDATER_URL=
# Gemeinsames Geheimnis Brain -> Updater, mindestens 16 Zeichen. MUSS bei
# beiden Diensten identisch sein. install.sh bzw. install.ps1 erzeugen den
# Wert beim Setup automatisch und haengen ihn an die .env an — auch bei einer
# bestehenden Installation. Ein bereits gesetzter Wert bleibt unangetastet.
# Fehlt er, verweigert der Updater jedes Update und die Oberflaeche sagt,
# was zu tun ist.
LOKYY_UPDATER_TOKEN=
# Erkennung ueberschreiben. Leer = automatisch, anhand der Erreichbarkeit:
#   local   — Updater wird erwartet. Ist er weg, meldet die Oberflaeche einen
#             Fehler statt "laeuft ueber die Plattform" (ehrlicher fuer eine
#             kaputte lokale Installation).
#   managed — nie ein Knopf; aktualisiert wird ueber die Deploy-Plattform.
#   off     — Update ueber die Oberflaeche komplett abgeschaltet.
