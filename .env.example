# lokyy-brain — root .env.example (deploy reference).
#
# This file lists every env var the production stack reads. For Coolify
# deployments use .env.coolify.example. For local docker-compose use
# docker-compose.local.yml directly — every value below already has a
# working default baked in, so `.env` is optional; copy this file only if
# you want to override something (cp .env.example .env, then
# `docker compose -f docker-compose.local.yml up -d`).
# For local non-docker dev: see server/.env.example.

# ── Database ─────────────────────────────────────────────────────────────
# Connection string used by both server and MCP. Inside docker the host is
# `postgres`; on bare-metal it's whatever you wired up.
DATABASE_URL=postgres://postgres:CHANGEME@postgres:5432/lokyy_brain
POSTGRES_PASSWORD=CHANGEME

# ── Ollama (embeddings + optional local chat) ───────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_PULL_CHAT=false
OLLAMA_CHAT_MODEL=llama3.1:8b

# ── Forgejo (vault git remote) ──────────────────────────────────────────
# Container-internal Forgejo URL during boot. Setup Wizard rewrites the
# remote to the public URL once you provide the FQDN.
GIT_REMOTE=http://forgejo:3000/oliver/lokyy-vault
GIT_BRANCH=main
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@localhost

# ── Server ───────────────────────────────────────────────────────────────
VAULT_DIR=/var/lokyy/vault
PORT=8787
NODE_ENV=production

# ── MCP HTTP transport ──────────────────────────────────────────────────
LOKYY_MCP_HTTP_PORT=8788
# OPTIONAL (legacy): static bearer token for MCP clients.
# Der empfohlene Weg ist Einstellungen → MCP → „Token erzeugen": der Token wird
# in der Datenbank verwaltet, gilt SOFORT ohne Neustart und lässt sich einzeln
# widerrufen. Diese Variable bleibt als Fallback gleichberechtigt gültig (alte
# Client-Configs laufen weiter), ändern erfordert aber einen Neustart.
# Leer lassen → /mcp akzeptiert ausschließlich die in der UI erzeugten Token.
# Wenn doch gesetzt: NIEMALS den Default aus docker-compose.local.yml benutzen —
# der steht im öffentlichen Repo. Generieren: openssl rand -hex 32
LOKYY_MCP_TOKEN=
# OAuth 2.1 consent-page password claude.ai users must enter to authorize.
# Defaults to LOKYY_MCP_TOKEN if unset.
LOKYY_OAUTH_PASSWORD=
# HS256 secret for signing OAuth access/refresh tokens.
# Defaults to a value derived from LOKYY_MCP_TOKEN if unset —
# set a strong random value in production (openssl rand -hex 32).
LOKYY_OAUTH_SIGNING_SECRET=
# Filled AFTER first Setup Wizard run — see DEPLOY.md step 5.
#
# MULTI-VAULT HAZARD — pin this explicitly. If LOKYY_VAULT_ID is empty AND the
# DB holds more than one vault row, the MCP server falls back to "pick oldest"
# (oldest created_at row) and logs a loud warning, but still attaches — which
# risks silently serving the WRONG vault (data-loss hazard). With exactly one
# vault the fallback is unambiguous; with several you MUST set this.
# Find the id (and match it to the slug you actually use):
#   docker exec <postgres-container> psql -U postgres -d lokyy_brain \
#     -c "SELECT id, slug FROM vaults;"
# then set LOKYY_VAULT_ID to the id whose slug is your real vault.
LOKYY_VAULT_ID=
# Must match an entry in <vault>/00_meta/mcp-scopes.yaml
LOKYY_AGENT_ID=claude-code

# ── Optional integrations (also configurable in the Settings UI) ────────
SUPADATA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
