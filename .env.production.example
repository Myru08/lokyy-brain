# lokyy-brain Production .env — cp zu .env und Werte setzen.

# ── Domain (A-Record muss auf VPS-IP zeigen) ──────────────────────────────
LOKYY_DOMAIN=lokyy.deine-domain.tld

# ── Vault / Forgejo ────────────────────────────────────────────────────────
GIT_REMOTE=https://forgejo.paione.de/oliver/mein-vault
GIT_BRANCH=main
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@your-domain.tld

# Vault-Row-ULID aus deinem produktiven Postgres (Settings-Page → vault.id)
LOKYY_VAULT_ID=01KSDM29DFRXCSAD812EQXHJGQ

# ── Auth & Secrets ─────────────────────────────────────────────────────────
# Generiere starke zufällige Werte: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
LOKYY_MCP_TOKEN=CHANGE_ME_long_random_token_min_32_chars

# Agent-Identity wie er in mcp-scopes.yaml steht. Default "claude-code" matched
# den im PAIONE Starter-Vault definierten Eintrag mit read:** + write:**.
LOKYY_AGENT_ID=claude-code

# ── Optional ───────────────────────────────────────────────────────────────
SUPADATA_API_KEY=
