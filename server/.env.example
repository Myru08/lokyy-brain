# lokyy-brain server — local dev .env.
# For full deploy reference (Coolify, docker-compose) see ../.env.example
# and ../.env.coolify.example.

# Pfad zum lokalen Git-Working-Clone des Vaults (wird beim ersten Start geklont)
VAULT_DIR=../vault

# Forgejo-Remote des Vault-Repos (SSH empfohlen — HTTPS flakt in Hooks/Skripten)
GIT_REMOTE=git@forgejo.example.com:oliver/vault.git
GIT_BRANCH=main

# Commit-Identitaet des Servers
GIT_AUTHOR_NAME=lokyy-brain
GIT_AUTHOR_EMAIL=lokyy-brain@localhost

# Postgres DSN (ParadeDB / pgvector image required — see docker-compose.yml)
DATABASE_URL=postgres://postgres:lokyy@localhost:5439/lokyy_brain

# Ollama host fuer Embeddings (Tier 2 semantic index)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Timeout pro Ollama-Request in Millisekunden (Default 300000 = 5 min).
# Hochsetzen, wenn lokale LLM-Rollen mit "This operation was aborted"
# abbrechen — ohne GPU braucht ein llama3.1:8b-Call gemessene ~77 s.
# Ungültige Werte werden ignoriert. Siehe docs/DEPLOY.md.
LOKYY_OLLAMA_TIMEOUT_MS=300000

# Supadata — fuer die YouTube-Pipe (Transkripte)
SUPADATA_API_KEY=

# Update-Check (Story 7.12). Einmal beim Start, 6 h gecacht, unauthentifizierter
# GET auf die CHANGELOG.md des oeffentlichen Repos — ohne Nutzerdaten, und ein
# Fehlschlag bleibt folgenlos. "off" schaltet ab, URL lenkt um (z. B. auf eine
# lokale Testdatei fuer QA).
LOKYY_UPDATE_CHECK=
LOKYY_UPDATE_CHECK_URL=

# Ein-Klick-Update (Story 7.12). Der Server fuehrt es nicht selbst aus, er
# reicht es an den Sidecar `lokyy-updater` weiter — `POST /api/system/update`
# und `GET /api/system/update/:id` sind duenne, admin-gegatete Weiterleitungen.
# Im lokalen Dev-Betrieb laeuft normalerweise kein Updater: dann meldet
# `GET /api/system/update` schlicht `canUpdate: false, reason: "managed"`.
# LOKYY_UPDATE_MODE=local|managed|off ueberschreibt die Erkennung.
# Den TOKEN (min. 16 Zeichen, bei Brain und Updater identisch) setzen in einer
# echten Installation install.sh bzw. install.ps1 automatisch; hier im Dev-Setup
# traegst du ihn nur ein, wenn du gegen einen laufenden Updater testen willst.
LOKYY_UPDATER_URL=
LOKYY_UPDATER_TOKEN=
LOKYY_UPDATE_MODE=

PORT=8787

# Cross-origin erlaubte Browser-Origins (Komma-Liste). Fuer den normalen Dev-Loop
# leer lassen: `pnpm --filter pwa dev` proxied /api auf diesen Port, die Seite
# spricht also mit ihrer eigenen Origin und CORS kommt nie ins Spiel. Leer setzt
# als Fallback Vites Default-Adressen (http://localhost:5173, http://127.0.0.1:5173),
# falls doch jemand direkt auf :8787 zeigt. Ein "*" gibt es nicht — die API
# authentifiziert per Session-Cookie.
LOKYY_CORS_ORIGINS=

# Session-Cookie `secure`-Flag. Leer lassen: dann leitet der Server ab —
# `false` im Dev (NODE_ENV != production), `true` in Produktion. Ein `secure`-
# Cookie wird vom Browser ueber reines HTTP verworfen und wuerde den lokalen
# HTTP-Login aussperren, darum bleibt Dev auf `false`. Explizit `true|false`
# ueberschreibt die Ableitung (z. B. `true`, wenn lokal ueber HTTPS getestet wird).
LOKYY_COOKIE_SECURE=
